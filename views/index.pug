
doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title みんなの掲示板
    link(rel="stylesheet" href="/style.css")
  body
    main.container
      h1 みんなの掲示板
      p.description 気軽にメッセージを投稿してみましょう。

      form(action="/posts" method="POST")
        textarea(name="message" placeholder="メッセージを入力してください" maxlength="200" required)
        button(type="submit") 投稿する

      h2 投稿一覧
      if posts.length
        each post in posts
          article.post
            p= post
      else
        p.empty まだ投稿はありません。
